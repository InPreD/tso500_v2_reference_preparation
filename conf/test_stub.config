/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run inpred/tso500_v2_reference_preparation -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 1,
        memory: '10MB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test Stub profile'
    config_profile_description = 'Stub test to check pipeline function'

    // Input data
    input                 = 'assets/samplesheet.csv'
    panel_bed             = 'assets/test_stub/panel.bed'
    gatk4_resource_labels = '--resource:hapmap,known=false,training=true,truth=true,prior=15.0 hapmap.vcf.gz;--resource:omni,known=false,training=true,truth=false,prior=12.0 omni.vcf.gz;--resource:1000G,known=false,training=true,truth=false,prior=10.0 1000G.vcf.gz;--resource:dbsnp,known=true,training=false,truth=false,prior=2.0 dbsnp.vcf.gz'
    gatk4_resources       = 'assets/test_stub/gatk4_resources'
    reference             = 'assets/test_stub/reference.fa'
    reference_dict        = 'assets/test_stub/reference.fa.dict'
    reference_fai         = 'assets/test_stub/reference.fa.fai'
    outdir                = 'test_stub_outdir'
}
