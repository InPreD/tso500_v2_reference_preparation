/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: BEDTOOLS_COVERAGE {
        // -d = Report the depth at each position in each A feature. Positions reported are one based. Each position and depth follow the complete A feature.
        ext.args = '-d'
    }

    withName: 'BEDTOOLS_MERGE_.*' {
        ext.prefix = { "${meta.id}_merged" }
    }

    withName: BEDTOOLS_SLOP {
        // -b = Increase the BED/GFF/VCF entry by the same number base pairs in each direction. Integer.
        ext.args = "-b ${params.extension_limit}"
        ext.prefix = { "${meta.id}_slop" }
    }

    withName: BEDTOOLS_SUBTRACT {
        ext.prefix = { "${meta.id}_complement" }
    }

    withName: FAI_TO_CHR_SIZES {
        publishDir = [
            enabled: false
        ]
    }

    withName: GATK4_ADDORREPLACEREADGROUPS {
        // --RGLB - Read-Group library
        // --RGPL - Read-Group platform (e.g. ILLUMINA, SOLID)
        // --RGPU - Read-Group platform unit (eg. run barcode)
        // --RGID - Read-Group ID
        // --RGSM - Read-Group sample name
        ext.args = { "--RGLB 'RUN_ID' --RGPL 'ILLUMINA' --RGPU 'RUN_ID' --RGID ${meta.id} --RGSM ${meta.id}" }
        ext.prefix = { "${meta.id}_RD" }
    }

    withName: GATK4_COLLECTREADCOUNTS {
        // --interval-merging-rule - Interval merging rule for abutting intervals
        ext.args = "--interval-merging-rule OVERLAPPING_ONLY"
    }

    withName: GATK4_HAPLOTYPECALLER {
        // --annotation - One or more specific annotations to add to variant calls
        // --emit-ref-confidence - Mode for emitting reference confidence scores (For Mutect2, this is a BETA feature)
        ext.args = "--annotation AlleleFraction --emit-ref-confidence GVCF"
    }

    withName: 'SORT_.*' {
        // -k = sort via a key; KEYDEF gives location and type
        ext.args = '-k1,1 -k2,2n'
        publishDir = [
            enabled: false
        ]
    }

}
